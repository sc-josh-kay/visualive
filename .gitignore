# ==========================================================================
# .gitignore for a Unity project (the Unity project is in ./play_visualizer/).
# Patterns are NOT anchored to the repo root so they also match the nested
# project folder. Keep: Assets/, Packages/, ProjectSettings/, and all *.meta.
# ==========================================================================

# --- Unity generated folders (never commit) ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Addressables / asset bundle build output
[Aa]ssets/[Ss]treamingAssets/aa/
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# --- Build artifacts ---
*.apk
*.aab
*.ipa
*.app
*.unitypackage
*.unitypackage.meta
ExportedObj/
crashlytics-build.properties
sysinfo.txt

# --- Auto-generated IDE / solution files ---
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.tmp
*.opendb
*.VC.db
*.pdb
*.mdb
.consulo/
.vs/
.vscode/
.idea/
*.DotSettings.user

# Unity crash dumps
*.stackdump

# --- OS cruft ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================================================
# NOTE: the .mp3 tracks in play_visualizer/Assets/Audio/Tracks are committed
# by default (the game references them). If you ever push this repo publicly,
# consider NOT committing commercial songs — uncomment the next two lines to
# exclude them (you'd then re-add tracks locally + run "Refresh Song List").
# ==========================================================================
# play_visualizer/Assets/Audio/Tracks/*.mp3
# !play_visualizer/Assets/Audio/Tracks/*.mp3.meta
